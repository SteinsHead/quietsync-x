{
  "manifest_version": 3,
  "name": "QuietSync for X",
  "short_name": "QuietSync",
  "version": "0.3.1",
  "minimum_chrome_version": "120",
  "description": "Pull, classify, review, and sync remote mute lists to X's native Muted words.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "QuietSync for X",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_page": "src/dashboard.html",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/settings/muted_keywords*",
        "https://twitter.com/settings/muted_keywords*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
